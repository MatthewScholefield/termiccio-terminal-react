{
  "name": "termiccio-terminal-react",
  "version": "0.1.1",
  "description": "React hooks and components for connecting a frontend to a termiccio-terminal FastAPI backend over WebSockets using xterm.js.",
  "type": "module",
  "license": "MIT",
  "author": "Matthew D. Scholefield",
  "homepage": "https://github.com/MatthewScholefield/termiccio-terminal-react",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatthewScholefield/termiccio-terminal-react.git"
  },
  "bugs": {
    "url": "https://github.com/MatthewScholefield/termiccio-terminal-react/issues"
  },
  "keywords": [
    "terminal",
    "xterm",
    "xterm.js",
    "react",
    "pty",
    "websocket",
    "fastapi",
    "termiccio"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@xterm/addon-fit": ">=0.10.0",
    "@xterm/xterm": ">=5.5.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.2.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.19.21",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.3.6",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
